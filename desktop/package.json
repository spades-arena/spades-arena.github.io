{
  "name": "spades-royale",
  "productName": "Spades Arena",
  "version": "1.0.0",
  "description": "Spades Arena \u2014 Play. Win. Rule. Made by Hadzz.",
  "author": "Hadzz",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.hadzz.spadesroyale",
    "productName": "Spades Arena",
    "copyright": "Made by Hadzz",
    "files": [
      "main.js",
      "icon.png",
      "app/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.card-games",
      "identity": null
    },
    "dmg": {
      "title": "Spades Arena",
      "artifactName": "Spades-Arena-Mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Spades Arena",
      "artifactName": "Spades-Arena-Windows-Setup.${ext}"
    }
  }
}
